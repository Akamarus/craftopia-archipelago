<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>CraftopiaArchipelago</AssemblyName>
    <RootNamespace>CraftopiaArchipelago</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <DebugType>none</DebugType>
    <AssemblyVersion>1.16.0</AssemblyVersion>
    <Version>1.16.0</Version>
  </PropertyGroup>

  <!-- Versioned skill catalog from runtime capture (embedded). -->
  <ItemGroup><EmbeddedResource Include="../../worlds/craftopia/soul_orbs_20261015_r1.json"><LogicalName>soul_orbs_20261015_r1.json</LogicalName></EmbeddedResource></ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="../../worlds/craftopia/skill_catalog_20261008_r1.json">
      <LogicalName>skill_catalog_20261008_r1.json</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup><EmbeddedResource Include="../../worlds/craftopia/equipment_catalog_20261010_r1.json"><LogicalName>equipment_catalog_20261010_r1.json</LogicalName></EmbeddedResource></ItemGroup>
  <!-- ValidationDecision is pure shared logic, compiled in. -->
  <ItemGroup>
    <Compile Include="..\ValidationDecision\ValidationDecision.cs" />
  </ItemGroup>

  <!-- Compile-only references. None of these ship with the mod. -->
  <ItemGroup>
    <Reference Include="UnityEngine.IMGUIModule"><HintPath>..\refs\UnityEngine.IMGUIModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.TextRenderingModule"><HintPath>..\refs\UnityEngine.TextRenderingModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.InputLegacyModule"><HintPath>..\refs\UnityEngine.InputLegacyModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="BepInEx">
      <HintPath>..\refs\BepInEx.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>..\refs\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="AD__Overcraft">
      <HintPath>..\refs\AD__Overcraft.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Mirror">
      <HintPath>..\refs\Mirror.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>..\refs\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>..\refs\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

<ItemGroup><EmbeddedResource Include="../../worlds/craftopia/milestones_20261016_r1.json" LogicalName="milestones_20261016_r1.json" /></ItemGroup>
<ItemGroup><EmbeddedResource Include="../../worlds/craftopia/milestones_20261017_r2.json" LogicalName="milestones_20261017_r2.json" /></ItemGroup>
<ItemGroup><Reference Include="UnityEngine.UI"><HintPath>../refs/UnityEngine.UI.dll</HintPath><Private>false</Private></Reference></ItemGroup>
<ItemGroup><EmbeddedResource Include="../../worlds/craftopia/geezah_orbs_20261016_r1.json" LogicalName="geezah_orbs_20261016_r1.json" /><EmbeddedResource Include="../../worlds/craftopia/millewind_orbs_20261017_r1.json" LogicalName="millewind_orbs_20261017_r1.json" /></ItemGroup>
</Project>
